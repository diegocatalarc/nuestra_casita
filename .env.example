# Copia este archivo a .env.local y rellénalo con los datos de tu proyecto Firebase.
# Si VITE_FIREBASE_API_KEY está vacío, el juego arranca en MODO DEMO LOCAL
# (dos pestañas del navegador = dos jugadores, sin necesidad de Firebase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://TU-PROYECTO-default-rtdb.firebaseio.com
